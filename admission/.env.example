# Supabase: Project Settings → Database → Connection string
# Use Transaction pooler (port 6543) for DATABASE_URL, Session/Direct (5432) for DIRECT_URL
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres"

# DashScope / 通义千问（与主站 server/.env 同一 key 即可）
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_EMBED_MODEL=text-embedding-v3

# 1 = 前端用 mock，不调真实 API（本地先跑 UI）
NEXT_PUBLIC_USE_MOCK=1

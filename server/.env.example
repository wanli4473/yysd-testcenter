# 复制为 .env 后填写（勿提交 .env）
PORT=3000
JWT_SECRET=请改成至少32位随机字符串

# 阿里云短信（控制台 → 签名/模板）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=合肥优益思达教育咨询
SMS_TEMPLATE_CODE=SMS_508955166

# 允许的前端来源（逗号分隔）
CORS_ORIGINS=https://youyisida.com,https://www.youyisida.com

# 通义千问 — 精听 / 口语评分（DashScope 控制台申请）
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-turbo

# 开发时可设为 1：不发真实短信，验证码打印在服务器日志
SMS_DEV_MODE=0

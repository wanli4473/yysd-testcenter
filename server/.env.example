# 复制为 .env 后填写（勿提交 .env）
#
# 上线清单（ECS 上按顺序执行）：
# 1. 阿里云备案控制台 → 为 api.youyisida.com 添加子域名接入
# 2. cp .env.example .env 并填写下方必填项
# 3. npm install --production && pm2 start server.js --name yysd-api
# 4. nginx 反代 api.youyisida.com → 127.0.0.1:3000（见 deploy/nginx-api.conf）
# 5. certbot --nginx -d api.youyisida.com
# 6. bash deploy/diagnose-api.sh
# 7. 浏览器打开 https://youyisida.com/login.html 测试验证码登录

PORT=3000
# 必填：openssl rand -hex 32
JWT_SECRET=

# 必填（登录验证码）：阿里云 RAM → AccessKey + 短信控制台签名/模板
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=合肥优益思达教育咨询
SMS_TEMPLATE_CODE=SMS_508955166

# 必填：前端域名（逗号分隔，含 www）
CORS_ORIGINS=https://youyisida.com,https://www.youyisida.com

# 可选（精听 / 口语 AI 评分；不填则 AI 接口返回 503）
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-turbo

# 教师端注册密钥（必填，仅持有密钥者可注册教师账号）
TEACHER_REGISTER_KEY=
